ENVIRONMENT=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
DATABASE_PATH=./data/anvikshiki.db
VECTOR_STORE_PATH=./data/vectors.db
FILE_STORE_PATH=./data/files
CACHE_TTL_SECONDS=300
SECRET_KEY=dev-only-change-me
# CHANGE THIS before exposing the server beyond localhost. Generate a
# strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-local-dev-key
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Web-Augmented Knowledge (opt-in; default OFF -- system is 100% local without this)
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3

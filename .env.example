PROJECT_NAME="Anvikshiki"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
RUNTIME_PROFILE=development
AUTH_MODE=required

# Database (PostgreSQL + pgvector required for development/integration)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=anvikshiki_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anvikshiki_db
# SQLite is reserved for isolated tests only.
TEST_DATABASE_URL=sqlite+aiosqlite:///./data/test.sqlite3

# Vite may be opened through localhost or a private LAN address. The backend
# accepts localhost plus RFC1918 Vite origins in development; set FRONTEND_URL
# for a non-default frontend host.
FRONTEND_URL=http://localhost:5173

# Local Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=True
LEXICAL_SEARCH_CONFIG=simple
LEXICAL_MAX_QUERY_LENGTH=1000
LEXICAL_DEFAULT_LIMIT=10
LEXICAL_MAX_RESULTS=100
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_LEXICAL_CANDIDATE_LIMIT=30
HYBRID_SEMANTIC_CANDIDATE_LIMIT=30
HYBRID_RRF_K=60
RERANKER_ENABLED=True
RERANKER_CANDIDATE_MULTIPLIER=2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_LOCAL_FILES_ONLY=True

# OCR (local Tesseract; leave executable path empty to use PATH)
ENABLE_OCR=True
OCR_TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=120
OCR_MIN_CONFIDENCE=0.60
WEB_MAX_RESPONSE_BYTES=5000000
WEB_REQUEST_TIMEOUT_SECONDS=20

# Storage Directories
STORAGE_LOCAL_ROOT=data/originals
EXTRACTED_LOCAL_ROOT=data/extracted
OCR_LOCAL_ROOT=data/OCR
CACHE_LOCAL_ROOT=data/cached_web
EXPORTS_LOCAL_ROOT=data/exports
TEMPORARY_LOCAL_ROOT=data/temporary
DOCUMENT_MAX_BYTES=50000000
